                "exec": [
                  "const timestamp = Date.now();\r",
                  "pm.environment.set(\"lessonSubjectForSite\", \"LessonSubject_\" + timestamp);\r",
                  "pm.environment.set(\"lessonLink\", \"https://meet.example.com/\" + timestamp);\r",
                  "\r",
                  "['subjectId', 'teacherId', 'groupId', 'semesterId'].forEach(v => {\r",
                  "    if (!pm.environment.get(v)) {\r",
                  "        pm.expect.fail(v + \" is empty! Run setup requests first.\");\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is array with created lessons\", () => {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json).to.be.an('array');\r",
                  "    pm.expect(json.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"First lesson has correct subjectForSite\", () => {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json[0].subjectForSite).to.eql(pm.environment.get(\"lessonSubjectForSite\"));\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "    const json = pm.response.json();\r",
                  "    if (json.length > 0 && json[0].id) {\r",
                  "        pm.environment.set(\"lessonId\", json[0].id);\r",
                  "    }\r",
